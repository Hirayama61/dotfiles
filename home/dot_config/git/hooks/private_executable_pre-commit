#!/usr/bin/env bash
# Sensitive-words guard hook
#
# ~/.config/git/sensitive-words.txt に列挙した語(1 行 1 パターン、grep -E)が
# staged diff に現れたらコミットをブロックする。リスト本体は隠したい文字列の
# 一覧そのものなので git 管理外のローカルファイルに置く(リポには .example のみ)。
#
# 誤検知時は git commit --no-verify で回避。リスト不在・追加行ゼロのときに
# 素通しになるのはこの段だけで、後続の secretlint 以降は走る。

set -eu

# リスト不在・追加行ゼロでの脱出を、この段だけの skip に閉じるための関数化。
# トップレベルで exit 0 すると、テキストの追加行を持たないコミット(バイナリ追加・
# 削除のみ・rename のみ)で後続の secretlint まで skip され、バイナリに埋めた秘密が
# 無検査で通る。
# ブロックは関数の中で exit する。`check_sensitive_words || exit 1` の形にすると
# 呼び出しが条件文脈になり、関数本体を実行する間だけ set -e が無効化される。
check_sensitive_words() {
  local words_file="$HOME/.config/git/sensitive-words.txt"
  [ -f "$words_file" ] || return 0

  # 追加行(先頭 +)だけを照合対象にする。削除行・コンテキスト行・diff ヘッダ(+++/---/@@)
  # まで含めると、機密語を「削除する」コミットや差分ヘッダのパス名で誤ブロックする(E-H2)。
  # ヘッダ除外は `+++ a/` `+++ b/` 形に限定する。単純な `^+++` だと、追加行の内容が `++` で
  # 始まる場合(diff 上は `++++secret...`)まで誤除外し機密語を取りこぼす(CodeRabbit PR#79)。
  # 末尾 CR も除去する。被検査側に CR が残ると end-anchor パターン($)が CRLF ファイルで
  # 取りこぼす(E-C2 のリスト側 strip と対称。GNU grep で顕著)。
  #
  # diff の出力形式は config と gitattributes で変わる。既定任せにすると照合が黙って
  # 空振りする(実測): color.ui=always なら追加行が ESC 列で始まって ^+ に当たらず、
  # .gitattributes の `* -diff` なら "Binary files ... differ" になって追加行が消える。
  # 後者はコミット内容なので、秘密を入れるコミット自身に同梱できる。
  # prefix も diff.mnemonicPrefix / diff.noprefix で a/ b/ 以外になり、ヘッダ除外が
  # 外れてパス名で誤ブロックする。すべて明示して固定する。
  # grep 側の --text も要る。NUL を含む入力は "Binary file matches" の 1 行に潰され、
  # git に --text を渡して取り出した追加行がそこで消える。
  local diff
  diff=$(git diff --cached --diff-filter=ACMR --no-color --text --no-ext-diff --no-textconv \
    --src-prefix=a/ --dst-prefix=b/ 2>/dev/null |
    grep -a '^+' | grep -av -E '^\+\+\+ [ab]/' | tr -d '\r' || true)
  [ -n "$diff" ] || return 0

  local found=0 word rc matches
  while IFS= read -r word || [ -n "$word" ]; do
    # CRLF のリストだと末尾 CR が ERE に混ざり全パターンが無効化される(E-C2)。
    word=${word%$'\r'}
    [[ -z "$word" || "$word" == \#* ]] && continue

    # 不正な ERE を `|| true` で握ると grep のエラー(rc>=2)をマッチ無しと取り違え、
    # typo パターンが沈黙スキップされる(E-C1)。rc>=2 はエラーとして fail-closed する。
    rc=0
    matches=$(printf '%s\n' "$diff" | grep -inE "$word") || rc=$?
    if [ "$rc" -ge 2 ]; then
      echo "ERROR: 機密語パターンが不正な正規表現です(grep rc=$rc): $word" >&2
      echo "~/.config/git/sensitive-words.txt の該当パターンを修正してください。" >&2
      exit 1
    fi
    [ -n "$matches" ] || continue

    if [ "$found" -eq 0 ]; then
      echo "ERROR: 機密語が staged 内容に含まれています。コミットを中止しました。" >&2
      echo >&2
      found=1
    fi
    echo "  パターン: $word" >&2
    # 一致行は staged 内容そのもの。残すのは TAB(\011)と LF(\012)だけで、表示を
    # 操作してブロック理由を隠せる制御文字(ESC / CR)は落とす。
    printf '%s\n' "$matches" | head -5 | tr -d '\000-\010\013-\037\177' |
      sed 's/^/    /' >&2
    echo >&2
  done <"$words_file"

  if [ "$found" -ne 0 ]; then
    echo "誤検知の場合のみ git commit --no-verify で回避してください。" >&2
    exit 1
  fi
  return 0
}

check_sensitive_words

# Secretlint guard
#
# staged(追加/変更分)に対し秘密情報スキャン。検出時はコミット中止。
# mise の npm 隔離インストールでは secretlint 本体と preset-recommend が別の
# install ディレクトリに入り secretlint のリゾルバが preset を解決できない。
# preset の node_modules を NODE_PATH で明示してこれを回避する。
# secretlint / preset / 設定ファイルの不在時は警告のみで素通し(他ブロックの方針に
# 合わせる)。起動できた後の非 0 は検出・実行失敗を問わず block する — 素通しにすると
# 走査されなかったコミットが警告 1 行で通り、ガードの不在に気付けない。

if mise which secretlint >/dev/null 2>&1; then
  preset_dir=$(mise where "npm:@secretlint/secretlint-rule-preset-recommend" 2>/dev/null || true)
  secretlintrc="$HOME/.secretlintrc.json"
  if [ -z "$preset_dir" ]; then
    echo "警告: secretlint preset が見つかりません。mise install を実行してください。" >&2
  elif [ ! -f "$secretlintrc" ]; then
    echo "警告: $secretlintrc がありません。mise run apply を実行してください。" >&2
  else
    # 走査対象は staged の追加/変更/rename 後のパス。R を落とすと git mv してから
    # 秘密を書き足す経路が漏れる(上の機密語ガードは ACMR で揃っている)。
    # プロセス置換は git の失敗を握り潰し、空一覧を「走査対象なし」と読ませてしまう。
    # 一時ファイルに落として終了ステータスを見る。
    staged_list=$(mktemp "${TMPDIR:-/tmp}/pre-commit-staged.XXXXXX") || {
      echo "ERROR: 一時ファイルを作成できませんでした。" >&2
      exit 1
    }
    # コミット中の Ctrl-C で staged パス一覧が $TMPDIR に残らないようにする。
    trap 'rm -f "$staged_list"' EXIT INT TERM
    list_status=0
    git diff --cached --name-only -z --diff-filter=ACMR >"$staged_list" || list_status=$?
    if [ "$list_status" -ne 0 ]; then
      rm -f "$staged_list"
      echo "ERROR: staged ファイル一覧を取得できませんでした(git exit $list_status)。" >&2
      exit 1
    fi

    # NUL 区切りの読み出しは bash 3.2(macOS 同梱)に mapfile が無いためループで行う。
    secret_files=()
    while IFS= read -r -d '' secret_file; do
      secret_files+=("$secret_file")
    done <"$staged_list"
    rm -f "$staged_list"
    trap - EXIT INT TERM

    # secretlint は通常ファイルしか解決できず、解決先が 0 件だと rc=2 で終わる。
    # submodule のポインタだけ / stage 後に worktree から消したパスだけのコミットは
    # 実行失敗として誤ブロックされるため、渡す前に実在ファイルへ絞る。
    scannable=()
    for secret_file in ${secret_files[@]+"${secret_files[@]}"}; do
      [ -f "$secret_file" ] && scannable+=("$secret_file")
    done

    # 削除のみのコミットなど、走査対象が 1 件も無いのは正常。set -u 下の空配列展開は
    # bash 3.2 では未定義変数扱いになり abort するため、起動する前に分岐する。
    if [ "${#scannable[@]}" -gt 0 ]; then
      # 設定と除外リストは cwd から上位へ探索される。どちらも固定しないと、リポ直下に
      # 置かれた .secretlintrc(ルールを空にする)や .secretlintignore(全パスを除外する)
      # で警告なくガードごと無効化される。$HOME 外(/tmp 等)のリポでは探索が届かず
      # 検査自体が成立しない。
      # --no-gitignore が無いと git add -f した無視対象ファイルが走査から外れる。
      # --no-glob が無いと引数は glob として解釈される(実体パス優先は文書化された
      # 保証ではない)。--no-color / --no-terminalLink は出力から端末制御列を減らす。
      # -- が無いと `-n` のような名前が staged にあるだけでオプションと解釈され、
      # パースエラーで走査されないまま終わる。
      # set -e 下では代入の失敗がその場で hook を終わらせるため || で status を受ける。
      secretlint_status=0
      secretlint_out=$(NODE_PATH="$preset_dir/lib/node_modules" \
        mise exec -- secretlint \
        --secretlintrc "$secretlintrc" --secretlintignore /dev/null \
        --no-gitignore --no-glob --no-color --no-terminalLink \
        -- "${scannable[@]}" 2>&1) || secretlint_status=$?

      if [ "$secretlint_status" -ne 0 ]; then
        # 出力は staged ファイルの内容由来。残すのは TAB(\011)と LF(\012)だけ。
        # ESC は直後のブロック表示を偽装でき、CR は行頭復帰で上書きできる。
        printf '%s\n' "$secretlint_out" | tr -d '\000-\010\013-\037\177' >&2
        echo "ERROR: secretlint が秘密情報を検出したか、実行に失敗しました(exit $secretlint_status)。" >&2
        echo "誤検知の場合のみ git commit --no-verify で回避してください。" >&2
        exit 1
      fi
    fi
  fi
else
  echo "警告: secretlint が見つかりません。mise install を実行してください。" >&2
fi

# shfmt auto-format
#
# staged の .sh を自動整形して再 stage する。インデントは本リポの全シェル
# スクリプトが2スペース統一のため -i 2(タブ基底は皆無)。不在時は素通し。

if mise which shfmt >/dev/null 2>&1; then
  sh_files=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep '\.sh$' || true)
  if [ -n "$sh_files" ]; then
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      # set -eu 下で shfmt が失敗(構文エラー等)すると hook が無言クラッシュし
      # コミットが理由不明に止まる(E-H1)。整形失敗は警告して再 stage を見送り、
      # 構文の実害は後段の shellcheck に委ねる。
      if mise exec -- shfmt -i 2 -w "$f"; then
        git add "$f"
      else
        echo "警告: shfmt が $f の整形に失敗しました(構文エラー?)。整形をスキップします。" >&2
      fi
    done <<<"$sh_files"
  fi
fi

# Shellcheck static analysis
#
# staged の .sh を静的解析(-x で source 追従)。問題検出でコミット中止。
# 解析ツール不在時は警告のみで素通し。

if mise which shellcheck >/dev/null 2>&1; then
  sh_files=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep '\.sh$' || true)
  if [ -n "$sh_files" ]; then
    sc_failed=0
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      if ! mise exec -- shellcheck -x "$f"; then
        sc_failed=1
      fi
    done <<<"$sh_files"
    if [ "$sc_failed" -ne 0 ]; then
      echo "ERROR: shellcheck が問題を検出しました。修正してからコミットしてください。" >&2
      exit 1
    fi
  fi
else
  echo "警告: shellcheck が見つかりません。mise install を実行してください。" >&2
fi

# ローカルフックのチェーン実行
#
# core.hooksPath をグローバル設定しているため、各リポの husky/lefthook/標準
# .git/hooks は本来 git 仕様で完全バイパスされる。上の security/品質ゲートを
# 全通過した後にここで明示委譲し、プロジェクト固有 pre-commit も走らせる。
# exec でプロセス置換するため、いずれかが起動したら以降の処理は無い。

# husky v9+
if [ -x ".husky/pre-commit" ]; then
  exec .husky/pre-commit "$@"
fi

# lefthook(PATH 直 → mise の順で検出。設定は lefthook.yml / lefthook.yaml を対象)
if [ -f "lefthook.yml" ] || [ -f "lefthook.yaml" ]; then
  if command -v lefthook >/dev/null 2>&1; then
    exec lefthook run pre-commit
  elif mise which lefthook >/dev/null 2>&1; then
    exec mise exec -- lefthook run pre-commit
  fi
fi

# 標準ローカルフック(.git/hooks/pre-commit)
# linked worktree では --git-dir が .git/worktrees/<名前> を指し hooks/ を持たない。
# git 自身は共有側で hook を解決するので、判定も --git-common-dir に合わせる。
git_dir=$(git rev-parse --git-common-dir 2>/dev/null || true)
if [ -n "$git_dir" ] && [ -x "$git_dir/hooks/pre-commit" ]; then
  exec "$git_dir/hooks/pre-commit" "$@"
fi

exit 0
